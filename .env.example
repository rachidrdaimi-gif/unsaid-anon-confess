# Copy this file to .env.local and fill in your Supabase project credentials.
# Find these in Supabase Dashboard -> Project Settings -> API.
# The anon key is safe to expose in a browser bundle ONLY because RLS policies
# in supabase/schema.sql restrict what it can actually do.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# SECURITY (audit finding, item 4): Cloudflare Turnstile site key for the
# sign-in/sign-up CAPTCHA in AuthModal.jsx. Get one free at
# https://dash.cloudflare.com -> Turnstile -> Add site (widget mode:
# "Managed"). This is the PUBLIC site key, safe in a browser bundle. You
# must also paste the matching SECRET key into Supabase Dashboard ->
# Authentication -> Attack Protection -> enable Turnstile — the widget
# below does nothing on its own until Supabase is told to require it.
VITE_TURNSTILE_SITE_KEY=YOUR-TURNSTILE-SITE-KEY
